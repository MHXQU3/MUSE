# Supabase: Project Settings > API (or the Connect button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the newer publishable key or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (never NEXT_PUBLIC_): the secret key from Project Settings > API Keys.
# Needed for the code sign-in's lockout and the test code.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional fixed sign-in code for one test account. Keep these out of the code.
MUSE_TEST_LOGIN_EMAIL=
MUSE_TEST_LOGIN_CODE=
